# ==============================================================================
# 开源排除项：构建分发产物、私有运维配置与发版脚本
# ==============================================================================
# 1. 构建打包产物 (避免 76MB 等二进制大文件进入 Git)
dist/
*.exe

# 2. 私有服务器运维配置 (避免泄露内部架构与证书路径)
config/nginx*.conf

# 3. 私有发版向导与自动化部署脚本
publish_release.bat
scripts/

# 4. 官网发布与落地页 (作为独立静态站点发布，不混入主客户端源码)
web_landing/

